{
  "entities": {
    "UserSession": {
      "title": "UserSession",
      "description": "Individual chat sessions for a specific user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "modelId": { "type": "string" },
        "messages": { "type": "array" }
      }
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Global models, providers, API keys, and active tiers configurations.",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "number" },
        "modelProviders": { "type": "object" },
        "keys": { "type": "object" },
        "activeModelTiers": { "type": "array" }
      }
    },
    "UserBehaviorProfile": {
      "title": "UserBehaviorProfile",
      "description": "Aggregated user behavior profile and tool usage stats for personalization.",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "profileUpdatedAt": { "type": "number" },
        "privacyMode": { "type": "string" },
        "sessions": { "type": "number" },
        "completedTasks": { "type": "number" },
        "failedTasks": { "type": "number" },
        "tools": { "type": "object" },
        "usagePatterns": { "type": "object" },
        "preferences": { "type": "object" },
        "lastSyncAt": { "type": "number" }
      }
    },
    "SoufAIMemory": {
      "title": "SoufAIMemory",
      "description": "Long-term user knowledge, preferences, and identity memories.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "projectName": { "type": "string" },
        "userName": { "type": "string" },
        "importance": { "type": "number" },
        "confidence": { "type": "number" },
        "source": { "type": "string" },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "type", "content", "createdAt", "updatedAt"]
    },
    "MemorySettings": {
      "title": "MemorySettings",
      "description": "User memory system settings and toggles.",
      "type": "object",
      "properties": {
        "memoryEnabled": { "type": "boolean" },
        "autoSuggest": { "type": "boolean" },
        "retentionDays": { "type": "number" },
        "maxContextItems": { "type": "number" }
      }
    }
  },
  "firestore": {
    "users/{userId}/sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "User specific chat sessions."
    },
    "users/{userId}/memories/{memoryId}": {
      "schema": "SoufAIMemory",
      "description": "User specific long-term memories."
    },
    "users/{userId}/settings/{settingId}": {
      "schema": "MemorySettings",
      "description": "User memory and system settings."
    },
    "users/{userId}/behavior/profile": {
      "schema": "UserBehaviorProfile",
      "description": "Aggregated user behavior summary profile for local-first personalization."
    },
    "admin_config/{configId}": {
      "schema": "AdminConfig",
      "description": "Admin configuration and API keys settings document."
    }
  }
}
